{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on"
      }
    },
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "attributePosition": "multiline",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noBannedTypes": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 10
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60
          }
        },
        "noImplicitCoercions": "error",
        "noUselessCatchBinding": "error",
        "noUselessFragments": "error",
        "noUselessReturn": "error",
        "noUselessUndefined": "error",
        "useMaxParams": "error",
        "useSimplifiedLogicExpression": "error",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noInvalidUseBeforeDeclaration": "error",
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error",
        "noUndeclaredDependencies": "error",
        "noUnreachable": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "noReactNativeRawText": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noExportedImports": "error",
        "noIncrementDecrement": "error",
        "noMagicNumbers": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": [
                  "memo",
                  "useCallback",
                  "useMemo"
                ],
                "message": "React Compiler memoizes. Write plain code."
              }
            },
            "patterns": [
              {
                "group": [
                  "../*",
                  "../**"
                ],
                "message": "Import across directories with the @/ alias."
              }
            ]
          }
        },
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDestructuring": "error",
        "useErrorCause": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": [
              "kebab-case"
            ],
            "requireAscii": true,
            "strictCase": true
          }
        },
        "useImportType": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "match": ".*",
                "selector": {
                  "kind": "typeMember"
                }
              },
              {
                "match": ".*",
                "selector": {
                  "kind": "objectLiteralMember"
                }
              }
            ],
            "strictCase": true
          }
        },
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useUnifiedTypeSignatures": "error",
        "noEnum": "error",
        "noProcessEnv": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noAssignInExpressions": "error",
        "noBitwiseOperators": "error",
        "noConsole": "error",
        "noDeprecatedImports": "error",
        "noDuplicatedSpreadProps": "error",
        "noDuplicateTestHooks": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noImplicitAnyLet": "error",
        "noImportCycles": "error",
        "noLeakedRender": "error",
        "noMisplacedAssertion": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noRedeclare": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noShadowRestrictedNames": "error",
        "noSkippedTests": "error",
        "noTsIgnore": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useGuardForIn": "error",
        "useIterableCallbackReturn": "error"
      },
      "a11y": {
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsForRole": "off",
        "useAriaPropsSupportedByRole": "off",
        "useHtmlLang": "off",
        "useKeyWithClickEvents": "off",
        "useMediaCaption": "off",
        "useSemanticElements": "off",
        "useValidAnchor": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 120
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/features/*/components/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/constants.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "formats": [
                      "CONSTANT_CASE"
                    ],
                    "selector": {
                      "kind": "const",
                      "scope": "global"
                    }
                  },
                  {
                    "match": ".*",
                    "selector": {
                      "kind": "any"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/no-functions-in-constants.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/types.ts"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/types-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/hooks.ts",
        "**/features/**/hooks.tsx",
        "**/features/**/hooks/**",
        "!**/*.test.*"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/hooks-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/schemas.ts",
        "**/features/**/schemas/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/schemas-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/helpers.ts",
        "**/features/**/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Helpers stay pure. React belongs in hooks and components."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/no-type-escapes.grit"
      ]
    },
    {
      "includes": [
        "**/*.config.{ts,mts,js,mjs}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.{test,spec}.{ts,tsx}",
        "**/e2e/**",
        "**/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/features/*/components/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": [
                  "PascalCase"
                ],
                "requireAscii": true,
                "strictCase": true
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noExportedImports": "off",
            "useFilenamingConvention": "off"
          }
        }
      },
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/routes-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/helpers.ts",
        "**/features/**/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "Helpers stay pure. React belongs in hooks and components.",
                  "react-native": "Helpers stay pure. React Native belongs in hooks and components."
                },
                "patterns": [
                  {
                    "group": [
                      "../*",
                      "../**"
                    ],
                    "message": "Import across directories with the @/ alias."
                  },
                  {
                    "group": [
                      "expo-*"
                    ],
                    "message": "Helpers stay pure. Expo modules belong in hooks and components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/features/theme/constants.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/no-raw-colors.grit"
      ]
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/constants.ts",
        "!db/**",
        "!scripts/**",
        "!tooling/**",
        "!**/*.config.ts",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/no-raw-numbers.grit"
      ]
    },
    {
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!test/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "plugins": [
        "./node_modules/@anstapol/biome-config/rules/pressable-role.grit",
        "./node_modules/@anstapol/biome-config/rules/lucide-by-path.grit"
      ]
    },
    {
      "includes": [
        "**/features/*/env.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**",
        "tooling/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off",
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.config.{ts,mts,js,mjs}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "plugins": [
    "./node_modules/@anstapol/biome-config/rules/no-inline-styles.grit"
  ]
}
