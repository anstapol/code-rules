{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "linter": {
    "rules": {
      "nursery": {
        "noReactNativeRawText": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/features/**/helpers.ts",
        "**/features/**/helpers/**",
        "**/src/*/helpers.ts",
        "**/src/*/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@prisma/client": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "dayjs": "Use date-fns.",
                  "drizzle-orm": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "expo-sqlite": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "lodash": "Use the platform or a helper in features/.",
                  "lodash-es": "Use the platform or a helper in features/.",
                  "moment": "Use date-fns.",
                  "react": "Helpers stay pure. React belongs in hooks and components.",
                  "react-native": "Helpers stay pure. React Native belongs in hooks and components.",
                  "underscore": "Use the platform or a helper in features/."
                },
                "patterns": [
                  {
                    "group": [
                      "@*/database/client",
                      "@prisma/client/*",
                      "drizzle-orm/*",
                      "expo-sqlite/*"
                    ],
                    "message": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noExportedImports": "off",
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/env.ts",
        "**/keys.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/pressable-role.grit",
        "./node_modules/@anstapol/code-rules/rules/lucide-by-path.grit"
      ]
    }
  ]
}
