{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "globals": [
      "LayoutProps",
      "PageProps",
      "RouteContext"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noNextAsyncClientComponent": "error",
        "useInlineScriptId": "error",
        "noProcessGlobal": "off"
      },
      "performance": {
        "noImgElement": "error",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "error",
        "useGoogleFontPreconnect": "error"
      },
      "style": {
        "noHeadElement": "error",
        "noProcessEnv": "off"
      },
      "suspicious": {
        "noDocumentImportInPage": "error",
        "noHeadImportInDocument": "error",
        "noUndeclaredEnvVars": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!**/env.ts",
        "!**/keys.ts",
        "!**/scripts/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/no-private-process-env.grit"
      ]
    },
    {
      "includes": [
        "**/helpers.ts",
        "**/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@prisma/client": "Only db/, database/ and repositories touch the database.",
                  "dayjs": "Use date-fns.",
                  "drizzle-orm": "Only db/, database/ and repositories touch the database.",
                  "expo-sqlite": "Only db/, database/ and repositories touch the database.",
                  "lodash": "Use the platform or a helper in features/.",
                  "lodash-es": "Use the platform or a helper in features/.",
                  "moment": "Use date-fns.",
                  "next/cache": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "next/headers": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "react": "Helpers stay pure. React belongs in hooks and components.",
                  "server-only": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "underscore": "Use the platform or a helper in features/."
                },
                "patterns": [
                  {
                    "group": [
                      "../*",
                      "../**"
                    ],
                    "message": "Import across directories with the @/ alias."
                  },
                  {
                    "group": [
                      "@prisma/client/*",
                      "drizzle-orm/*",
                      "expo-sqlite/*",
                      "@*/database/client"
                    ],
                    "message": "Only db/, database/ and repositories touch the database."
                  },
                  {
                    "group": [
                      "@/db",
                      "@/db/*",
                      "**/repositories",
                      "**/repositories/*"
                    ],
                    "message": "Helpers stay pure. Do I/O in repositories, queries, actions or hooks."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noExportedImports": "off",
            "useComponentExportOnlyModules": {
              "level": "error",
              "options": {
                "allowConstantExport": false,
                "allowExportNames": [
                  "alt",
                  "contentType",
                  "dynamic",
                  "dynamicParams",
                  "experimental_ppr",
                  "fetchCache",
                  "generateImageMetadata",
                  "generateMetadata",
                  "generateSitemaps",
                  "generateStaticParams",
                  "generateViewport",
                  "maxDuration",
                  "metadata",
                  "preferredRegion",
                  "revalidate",
                  "runtime",
                  "size",
                  "viewport"
                ]
              }
            }
          }
        }
      },
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/routes-only.grit"
      ]
    },
    {
      "includes": [
        "**/emails/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/actions.ts",
        "**/actions/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**",
        "!**/components/**",
        "!**/hooks.ts",
        "!**/hooks.tsx",
        "!**/hooks/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    }
  ]
}
