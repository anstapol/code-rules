{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "overrides": [
    {
      "includes": [
        "**",
        "!**/env.ts",
        "!**/keys.ts",
        "!**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "!**/next-config.ts",
        "!**/prisma/**",
        "!**/scripts/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/no-private-process-env.grit"
      ]
    },
    {
      "includes": [
        "packages/*/src/index.ts",
        "packages/*/src/*/index.ts",
        "packages/*/src/*/server.ts",
        "tooling/*/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/next-config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
