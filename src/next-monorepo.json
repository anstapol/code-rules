{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "globals": [
      "LayoutProps",
      "PageProps",
      "RouteContext"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noBeforeInteractiveScriptOutsideDocument": "error",
        "noNextAsyncClientComponent": "error",
        "useInlineScriptId": "error",
        "noProcessGlobal": "off"
      },
      "performance": {
        "noImgElement": "error",
        "noSyncScripts": "error",
        "noUnwantedPolyfillio": "error",
        "useGoogleFontPreconnect": "error"
      },
      "style": {
        "noHeadElement": "error",
        "noProcessEnv": "off"
      },
      "suspicious": {
        "noDocumentImportInPage": "error",
        "noHeadImportInDocument": "error",
        "noUndeclaredEnvVars": "error"
      },
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!**/env.ts",
        "!**/keys.ts",
        "!**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "!**/next-config.ts",
        "!**/prisma/**",
        "!**/scripts/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/no-private-process-env.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/helpers.ts",
        "**/features/**/helpers/**",
        "**/src/*/helpers.ts",
        "**/src/*/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "dayjs": "Use date-fns.",
                  "lodash": "Use the platform or a helper in features/.",
                  "lodash-es": "Use the platform or a helper in features/.",
                  "moment": "Use date-fns.",
                  "next/cache": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "next/headers": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "react": "Helpers stay pure. React belongs in hooks and components.",
                  "server-only": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "underscore": "Use the platform or a helper in features/."
                },
                "patterns": [
                  {
                    "group": [
                      "@*/database/client"
                    ],
                    "message": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**",
        "**/email/templates/**",
        "**/emails/**",
        "**/mdx-components.tsx",
        "**/mdx-layout.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noExportedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**",
        "!**/components/**",
        "!**/hooks.ts",
        "!**/hooks.tsx",
        "!**/hooks/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/*/src/index.ts",
        "packages/*/src/*/index.ts",
        "packages/*/src/*/server.ts",
        "tooling/*/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/prisma/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/next-config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
