{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedKeys": "on"
      }
    },
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "attributePosition": "multiline",
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "none"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60
          }
        },
        "noImplicitCoercions": "error",
        "noUselessCatchBinding": "error",
        "noUselessFragments": "error",
        "noUselessReturn": "error",
        "noUselessUndefined": "error",
        "useMaxParams": "error",
        "useSimplifiedLogicExpression": "error"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "noReactNativeRawText": "off",
        "noReactPropAssignments": "error",
        "noUndeclaredDependencies": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "useTailwindSortedClasses": {
          "fix": "safe",
          "level": "error"
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noExportedImports": "error",
        "noIncrementDecrement": "error",
        "noMagicNumbers": "error",
        "noNestedTernary": "error",
        "noNonNullAssertion": "error",
        "noParameterAssign": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react": {
                "importNames": [
                  "memo",
                  "useCallback",
                  "useMemo"
                ],
                "message": "React Compiler memoizes. Write plain code."
              }
            }
          }
        },
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentObjectDefinitions": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDestructuring": "error",
        "useErrorCause": "error",
        "useExportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": [
              "kebab-case"
            ],
            "requireAscii": true,
            "strictCase": true
          }
        },
        "useImportType": "error",
        "useNamingConvention": {
          "level": "error",
          "options": {
            "conventions": [
              {
                "match": ".*",
                "selector": {
                  "kind": "typeMember"
                }
              },
              {
                "match": ".*",
                "selector": {
                  "kind": "objectLiteralMember"
                }
              },
              {
                "formats": [
                  "PascalCase"
                ],
                "match": "T?(.+)",
                "selector": {
                  "kind": "typeParameter"
                }
              }
            ],
            "strictCase": true
          }
        },
        "useObjectSpread": "error",
        "useReactFunctionComponents": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noBitwiseOperators": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": [
              "error",
              "warn"
            ]
          }
        },
        "noDeprecatedImports": "error",
        "noDuplicatedSpreadProps": "error",
        "noDuplicateTestHooks": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noExplicitAny": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noImportCycles": "error",
        "noLeakedRender": "error",
        "noMisplacedAssertion": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noTsIgnore": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useGuardForIn": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.tsx"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 120
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/features/*/components/**",
        "**/src/*/components/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useComponentExportOnlyModules": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/constants.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": {
              "level": "error",
              "options": {
                "conventions": [
                  {
                    "formats": [
                      "CONSTANT_CASE"
                    ],
                    "selector": {
                      "kind": "const",
                      "scope": "global"
                    }
                  },
                  {
                    "match": ".*",
                    "selector": {
                      "kind": "any"
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/no-functions-in-constants.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/types.ts",
        "**/src/*/types.ts",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/types-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/hooks.ts",
        "**/features/**/hooks.tsx",
        "**/features/**/hooks/**",
        "**/src/*/hooks.ts",
        "**/src/*/hooks.tsx",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/hooks-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/schemas.ts",
        "**/features/**/schemas/**",
        "**/src/*/schemas.ts",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/schemas-only.grit"
      ]
    },
    {
      "includes": [
        "**/features/**/helpers.ts",
        "**/features/**/helpers/**",
        "**/src/*/helpers.ts",
        "**/src/*/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@prisma/client": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "drizzle-orm": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "expo-sqlite": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "react": "Helpers stay pure. React belongs in hooks and components."
                },
                "patterns": [
                  {
                    "group": [
                      "@*/database/client",
                      "@prisma/client/*",
                      "drizzle-orm/*",
                      "expo-sqlite/*"
                    ],
                    "message": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/features/**/tools.ts",
        "**/features/**/tools/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@prisma/client": "Tools adapt the feature for the model. Read in queries, write in server.ts.",
                  "drizzle-orm": "Tools adapt the feature for the model. Read in queries, write in server.ts.",
                  "expo-sqlite": "Tools adapt the feature for the model. Read in queries, write in server.ts."
                },
                "patterns": [
                  {
                    "group": [
                      "@*/database/client",
                      "@prisma/client/*",
                      "drizzle-orm/*",
                      "expo-sqlite/*"
                    ],
                    "message": "Tools adapt the feature for the model. Read in queries, write in server.ts."
                  }
                ]
              }
            }
          }
        }
      },
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/tools-only.grit"
      ]
    },
    {
      "includes": [
        "**/*.{ts,tsx}",
        "!**/features/**/tools.ts",
        "!**/features/**/tools/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/define-tool-in-tools.grit"
      ]
    },
    {
      "includes": [
        "**/*.{ts,tsx}",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/no-type-escapes.grit"
      ]
    },
    {
      "includes": [
        "**/*.config.{ts,mts,cts,js,mjs,cjs}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/scripts/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.{test,spec}.{ts,tsx}",
        "**/e2e/**",
        "**/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      },
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "it",
          "jest",
          "test"
        ]
      }
    },
    {
      "includes": [
        "**/features/**/helpers.ts",
        "**/features/**/helpers/**",
        "**/src/*/helpers.ts",
        "**/src/*/helpers/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@prisma/client": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "drizzle-orm": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "expo-sqlite": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "next/cache": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "next/headers": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts.",
                  "react": "Helpers stay pure. React belongs in hooks and components.",
                  "server-only": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts."
                },
                "patterns": [
                  {
                    "group": [
                      "@*/database/client",
                      "@prisma/client/*",
                      "drizzle-orm/*",
                      "expo-sqlite/*"
                    ],
                    "message": "Helpers stay pure. Do I/O in queries, mutations, actions or server.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**",
        "**/email/templates/**",
        "**/emails/**",
        "**/mdx-components.tsx",
        "**/mdx-layout.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noExportedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/app/**/apple-icon.tsx",
        "**/app/**/icon.tsx",
        "**/app/**/opengraph-image.tsx",
        "**/app/**/twitter-image.tsx"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/prisma/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**",
        "!**/env.ts",
        "!**/keys.ts",
        "!**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "!**/next-config.ts",
        "!**/prisma/**",
        "!**/scripts/**",
        "!**/*.{test,spec}.{ts,tsx}",
        "!**/e2e/**",
        "!**/test/**"
      ],
      "plugins": [
        "./node_modules/@anstapol/code-rules/rules/no-private-process-env.grit"
      ]
    },
    {
      "includes": [
        "packages/*/src/index.ts",
        "packages/*/src/*/index.ts",
        "packages/*/src/*/server.ts",
        "tooling/*/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/next-config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
