language js

or {
  JsStringLiteralExpression() as $node where {
    $node <: or {
      r"['\"]#[0-9a-fA-F]{3,8}['\"]",
      r"['\"]rgba?\(.*['\"]",
      r"['\"]hsla?\(.*['\"]",
      r"['\"].*gradient\(.*['\"]"
    },
    register_diagnostic(span=$node, message="Raw colours live only in features/theme/constants.ts. Read them from the theme.")
  },
  JsPropertyObjectMember(name=$name) as $node where {
    $name <: r"fontFamily",
    register_diagnostic(span=$node, message="Font families live only in features/theme/constants.ts. Spread a theme.type style.")
  },
  JsPropertyObjectMember(name=$name) as $node where {
    $name <: r"fontWeight",
    register_diagnostic(span=$node, message="Each font weight is its own family. Spread a theme.type style instead of fontWeight.")
  }
}
