language js

JsPropertyObjectMember(name=$name, value=JsNumberLiteralExpression() as $number) where {
  $number <: not or {
    r"0",
    r"1"
  },
  $name <: not or {
    r"flex",
    r"flexGrow",
    r"flexShrink",
    r"aspectRatio"
  },
  register_diagnostic(span=$number, message="Raw numbers in an object hide sizes and timings. Use a theme token, or name it in this feature's constants.ts.")
}
