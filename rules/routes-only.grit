language js

or {
  JsFunctionDeclaration(),
  JsFunctionExpression(),
  JsArrowFunctionExpression(),
  JsClassDeclaration(),
  JsxElement(),
  JsxSelfClosingElement(),
  JsxFragment()
} as $node where {
  register_diagnostic(span=$node, message="Route files only re-export. Build the screen or handler under features/<feature>/ and re-export it here.")
}
