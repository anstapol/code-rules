language js

or {
  JsFunctionDeclaration(),
  JsFunctionExpression(),
  JsArrowFunctionExpression(),
  JsClassDeclaration(),
  JsxElement(),
  JsxSelfClosingElement(),
  JsxFragment()
} as $node where {
  register_diagnostic(span=$node, message="Route files only re-export a screen. Build it under features/<feature>/components/ and `export default` the import here.")
}
