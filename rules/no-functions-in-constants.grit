language js

or {
  JsFunctionDeclaration(),
  JsVariableDeclarator(initializer=JsInitializerClause(expression=or {
    JsArrowFunctionExpression(),
    JsFunctionExpression()
  }))
} as $fn where {
  $fn <: not within or {
    JsFunctionBody(),
    JsArrowFunctionExpression()
  } ,
  register_diagnostic(span=$fn, message="constants.ts holds values only. Move functions to helpers.ts.")
}
